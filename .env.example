# Local SQLite (use libsql/Turso URL in production, e.g. libsql://xxx.turso.io)
DATABASE_URL=file:./data/thblog.db
# DATABASE_AUTH_TOKEN=

# Better Auth
BETTER_AUTH_SECRET=
